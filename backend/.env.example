# Copy to backend/.env for local runs. On Railway set these as service Variables instead.
# Never commit real values.

# --- AI (without a key the app runs in MOCK mode with demo data) ---
# Free key: https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# LLM_JUDGE=1                 # extra LLM review call per top candidate
# MAX_QUERIES=4               # searches per investigation (each uses API quota)

# --- Secrets (REQUIRED in production; dev fallback generates them into DATA_DIR) ---
# JWT_SECRET=<48+ random chars>            python -c "import secrets;print(secrets.token_urlsafe(48))"
# EVIDENCE_KEY=<Fernet key>                python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# IP_HASH_SALT=<random string>

# --- Storage (on Railway mount a volume at /data and set DATA_DIR=/data) ---
# DATA_DIR=./data
# AUDIT_DB_PATH=./data/audit.db          # keep the audit log on separate storage if you can
# AUDIT_MIRROR_PATH=./data/audit.jsonl   # ship this append-only file to WORM storage

# --- Security policy ---
# CORS_ORIGINS=http://localhost:3000
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# MFA_REQUIRED_ROLES=super_admin,security_admin,investigator
# RATE_LIMIT_PER_HOUR=30
# RETENTION_DAYS=90
# BREAK_GLASS_HOURS=4
# MAX_UPLOAD_MB=10
# FETCH_DENY_DOMAINS=
# ALERT_SEARCHES_PER_5MIN=20
# ALERT_DISTINCT_TARGETS_PER_HOUR=15
# ALERT_FAILED_LOGINS_PER_15MIN=5
# ALERT_EXPORTS_PER_HOUR=20
