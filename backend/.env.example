# Copy to backend/.env for local runs. On Railway set these as service Variables instead.
# Never commit real values.

# --- AI (without a key the app runs in MOCK mode with demo data) ---
# Free key: https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# LLM_JUDGE=1                 # extra LLM review call per top candidate
# MAX_QUERIES=4               # searches per investigation (each uses API quota)

# --- Secrets (REQUIRED in production; dev fallback generates them into DATA_DIR) ---
# JWT_SECRET=<48+ random chars>            python -c "import secrets;print(secrets.token_urlsafe(48))"
# EVIDENCE_KEY=<Fernet key>                python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# IP_HASH_SALT=<random string>

# --- Storage (on Railway mount a volume at /data and set DATA_DIR=/data) ---
# DATA_DIR=./data
# AUDIT_DB_PATH=./data/audit.db          # keep the audit log on separate storage if you can
# AUDIT_MIRROR_PATH=./data/audit.jsonl   # ship this append-only file to WORM storage

# --- Security policy ---
# CORS_ORIGINS=http://localhost:3000
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# MFA_REQUIRED_ROLES=super_admin,security_admin,investigator
# RATE_LIMIT_PER_HOUR=30
# RETENTION_DAYS=90
# BREAK_GLASS_HOURS=4
# MAX_UPLOAD_MB=10
# FETCH_DENY_DOMAINS=
# ALERT_SEARCHES_PER_5MIN=20
# ALERT_DISTINCT_TARGETS_PER_HOUR=15
# ALERT_FAILED_LOGINS_PER_15MIN=5
# ALERT_EXPORTS_PER_HOUR=20

# --- Scale-out (optional): shared rate limits + reliable job queue for several API replicas ---
# REDIS_URL=redis://default:<password>@redis.railway.internal:6379
# With REDIS_URL set, run a worker service from the same image with start command: ./start.sh worker

# --- Audit export (optional) ---
# EXPORT_INTERVAL=30
# SIEM_WEBHOOK_URL=https://splunk.example.com:8088/services/collector
# SIEM_FORMAT=splunk_hec            # or json
# SIEM_AUTH_HEADER=Splunk <hec-token>
# WORM_S3_BUCKET=my-audit-bucket    # create it WITH Object Lock enabled
# WORM_S3_PREFIX=audit/
# WORM_S3_ENDPOINT=                 # empty for AWS S3; set for MinIO / Backblaze B2
# WORM_S3_REGION=ap-south-1
# WORM_RETENTION_DAYS=2555
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=   (credentials for the WORM bucket)

# --- Single sign-on (optional, OIDC: Google Workspace, Microsoft Entra ID, Okta, Auth0, Keycloak) ---
# In the IdP, register a web app with redirect URI https://<frontend-domain>/bff/oidc/callback
# OIDC_ISSUER=https://accounts.google.com            # Entra: https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://<frontend-domain>/bff/oidc/callback
# OIDC_PROVIDER_NAME=Google
# OIDC_DEFAULT_ROLE=user                              # first-time SSO users; admins can promote them
# OIDC_ALLOWED_DOMAINS=yourcompany.com
# OIDC_REQUIRE_MFA=1                                  # require the IdP to report MFA (amr claim)
